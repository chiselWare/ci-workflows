name: Reusable Workflow - Smoke Test

on:
  workflow_call:
    inputs:
      message:
        required: false
        type: string
        default: "Hello from chiselWare/ci-workflow reusable workflow"

jobs:
  smoke:
    name: smoke
    runs-on: ubuntu-latest
    steps:
      - name: Print message
        run: |
          echo "${{ inputs.message }}"
          echo "Repo: ${{ github.repository }}"
          echo "Ref:  ${{ github.ref }}"
          echo "SHA:  ${{ github.sha }}"
